                        candidate = candidate_from_item(spec, item, url)
                        outcome = self.store.upsert_candidate(candidate, item, run_id)
                        if outcome == "created":
                            metrics.created += 1
                        elif outcome == "unchanged":
                            metrics.unchanged += 1
                        else:
