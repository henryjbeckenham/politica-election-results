                (entity_set,),
            ).fetchone()
        return dict(row[0]) if row else None

    def snapshot(self) -> dict[str, Any]:
        with self._connect() as connection:
            runs = {
                row[0]: self.get_run(row[0])
                for row in connection.execute("SELECT run_id FROM stage5_runtime.runs ORDER BY run_id").fetchall()
            }
            checkpoints = {}
            for row in connection.execute(
                "SELECT run_id,entity_set,partition,cursor,completed_pages,candidate_count,updated_at,configuration_hash,contract_hash "
                "FROM stage5_runtime.checkpoints ORDER BY run_id,entity_set,partition"
            ).fetchall():
                key = f"{row[0]}:{row[1]}:{row[2]}"
                checkpoints[key] = {
                    "run_id": row[0], "entity_set": row[1], "partition": row[2], "cursor": row[3],
                    "completed_pages": row[4], "candidate_count": row[5], "updated_at": row[6].isoformat(),
                    "configuration_hash": row[7], "contract_hash": row[8],
                }
            candidates = {
                row[0]: {
                    "entity_type": row[1], "external_identifier": row[2], "source_url": row[3],
                    "observed_fingerprint": row[4], "item_hash": row[5], "first_seen_run_id": row[6],
                    "last_seen_run_id": row[7], "item": row[8],
                }
                for row in connection.execute(
                    "SELECT candidate_identity,entity_type,external_identifier,source_url,observed_fingerprint,item_hash,first_seen_run_id,last_seen_run_id,item FROM stage5_runtime.candidates ORDER BY candidate_identity"
                ).fetchall()
            }
            raw_captures = {
                row[0]: {
                    **row[1],
                    "database_body_sha256": row[2],
                    "database_byte_count": row[3],
                }
                for row in connection.execute(
                    "SELECT capture_identity,record,body_sha256,byte_count FROM stage5_runtime.raw_captures ORDER BY capture_identity"
                ).fetchall()
            }
            watermarks = {
                row[0]: {**row[2], "database_run_id": row[1]}
                for row in connection.execute(
                    "SELECT entity_set,run_id,watermark FROM stage5_runtime.watermarks ORDER BY entity_set"
                ).fetchall()
            }
        return {
            "runs": runs,
            "checkpoints": checkpoints,
            "candidates": candidates,
            "raw_captures": raw_captures,
            "watermarks": watermarks,
        }
