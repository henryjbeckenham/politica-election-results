# Copy this file to the project root as .env and replace the example path.
# The .env file stores only the key's path, not the key contents, and is ignored by Git.
# Share the Grand Database with the JSON key's client_email as Viewer.
POLITICA_GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
POLITICA_GRAND_DATABASE_ID=1dEqeqQU3fbbow8JBoQypEFDJL7K7bek1mG_7PmVL0aI

# Optional only for Google Workspace domain-wide delegation:
# POLITICA_GOOGLE_DELEGATED_SUBJECT=operator@example.com
